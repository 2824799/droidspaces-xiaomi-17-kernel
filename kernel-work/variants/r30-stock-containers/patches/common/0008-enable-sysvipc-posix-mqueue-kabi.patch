From 2a5255cb5e63f2345bfa4ea1d5db849e34f4062d Mon Sep 17 00:00:00 2001
From: Codex local builder <codex@local.invalid>
Date: Thu, 27 Aug 2026 22:23:28 +0800
Subject: [PATCH] LOCAL: enable SYSVIPC and POSIX mqueue for containers

Move the SYSVIPC task state into the existing 28-byte hole before sched_entity so enabling CONFIG_SYSVIPC does not shift the established task_struct layout. The KABI layout is adapted from Droidspaces-OSS commit 0b8dbd4001f3ee7dc06e8d7376d19e9ffe79c96c, patch SHA-256 059db74ecf615273785f25c54b0b26f61cee9ea330d3b4787cdfd8172778eaad. CONFIG_IPC_NS is not written explicitly because it defaults to y once SYSVIPC or POSIX_MQUEUE satisfies its Kconfig dependency.

Change-Id: Ic6a0c4272c2c10f05591435b1437e87f4278990e
---
 arch/arm64/configs/gki_defconfig |  2 ++
 include/linux/sched.h            | 15 +++++++++++----
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/arch/arm64/configs/gki_defconfig b/arch/arm64/configs/gki_defconfig
index 3f9b5ffff37b..5c305a34b0c8 100644
--- a/arch/arm64/configs/gki_defconfig
+++ b/arch/arm64/configs/gki_defconfig
@@ -1,4 +1,6 @@
 CONFIG_LOCALVERSION="-4k"
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
 CONFIG_AUDIT=y
 CONFIG_TIME_KUNIT_TEST=m
 CONFIG_NO_HZ=y
diff --git a/include/linux/sched.h b/include/linux/sched.h
index fba4a5364f01..0f68c8bc8abc 100644
--- a/include/linux/sched.h
+++ b/include/linux/sched.h
@@ -866,6 +866,17 @@ struct task_struct {
 	int				normal_prio;
 	unsigned int			rt_priority;
 
+#ifdef CONFIG_SYSVIPC
+	union {
+		char __kabi_ignored_0;
+		struct sysv_sem			sysvsem;
+	} __packed;
+	union {
+		char __kabi_ignored_1;
+		struct sysv_shm			sysvshm;
+	} __packed;
+#endif
+
 	struct sched_entity		se;
 	struct sched_rt_entity		rt;
 	struct sched_dl_entity		dl;
@@ -1172,10 +1183,6 @@ struct task_struct {
 
 	struct nameidata		*nameidata;
 
-#ifdef CONFIG_SYSVIPC
-	struct sysv_sem			sysvsem;
-	struct sysv_shm			sysvshm;
-#endif
 #ifdef CONFIG_DETECT_HUNG_TASK
 	unsigned long			last_switch_count;
 	unsigned long			last_switch_time;
-- 
2.55.0

