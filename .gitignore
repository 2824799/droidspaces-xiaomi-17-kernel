/kernel-work/worktrees/

# Downloaded tools, caches, logs, outputs, and binary artifacts
/kernel-work/tools/
/kernel-work/cache/
/kernel-work/logs/
/kernel-work/out/
/kernel-work/artifacts/

# Common Android/Kleaf/Bazel generated directories
